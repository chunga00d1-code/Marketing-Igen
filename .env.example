
# OpenRouter — nhà cung cấp chính cho text + image generation
OPENROUTER_API_KEY=sk-or-your-key-here

# Model sinh ảnh qua OpenRouter
# Gemini 3.1 Flash Image (Nano Banana 2) — dùng chat completions, hỗ trợ reference images
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image"
# Hoặc dùng Gemini 3 Pro Image (Nano Banana Pro):
# OPENROUTER_IMAGE_MODEL="google/gemini-3-pro-image"

# Model text mặc định (không cần prefix — code tự thêm "google/")
GEMINI_MODEL="gemini-2.5-flash"

# Apify research evidence for campaign slots. Leave disabled until an Apify token is configured.
# Test mode records provider cost and evidence in the slot audit; it never deducts the ERP wallet.
APIFY_RESEARCH_ENABLED=false
APIFY_TOKEN=
APIFY_BILLING_MODE=shadow
APIFY_RESEARCH_CACHE_HOURS=12
APIFY_MAX_COST_PER_SLOT_USD=0.25
APIFY_MAX_COST_PER_CAMPAIGN_USD=3.00
APIFY_GOOGLE_ACTOR_ID=apify/google-search-scraper
APIFY_GOOGLE_MAX_RESULTS=10
# Facebook Posts Scraper needs explicit public Page URLs; comma-separate approved competitor/market pages.
APIFY_FACEBOOK_ACTOR_ID=apify/facebook-posts-scraper
APIFY_FACEBOOK_PAGE_URLS=
APIFY_FACEBOOK_MAX_RESULTS=20
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
APIFY_TIKTOK_MAX_RESULTS=20

# Gemini API key — chỉ cần cho video analysis (Gemini Files API)
# Để trống nếu không dùng tính năng phân tích nội dung video
GEMINI_API_KEY=your-gemini-api-key-here

# Model sinh video (dùng PIAPI)
GEMINI_VIDEO_MODEL="veo31-video-fast-audio"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Super Admin Account Seed configuration credentials
VITE_SUPERADMIN_EMAIL=sxxx
VITE_SUPERADMIN_PASSWORD=sxxx
VITE_SUPERADMIN_NAME=xxx

# n8n Integration Config
# Production webhook URL of the imported Facebook campaign publisher workflow.
N8N_CAMPAIGN_FB_WEBHOOK_URL=https://n8n.your-domain.com/webhook/campaign-facebook-publish
# Keep the legacy/manual Facebook scheduling workflow on its own URL.
N8N_FB_WEBHOOK_URL=https://n8n.your-domain.com/webhook/fb-post
N8N_FB_VALIDATE_URL=xxx
N8N_TT_VALIDATE_URL=xxx
# Use different random values in production. Never commit real secrets.
N8N_WEBHOOK_SECRET=replace-with-a-long-random-callback-secret
CAMPAIGN_WORKER_SECRET=replace-with-a-long-random-worker-secret
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.com/api/v1/tiktok/oauth/callback
# Reserved for a future TikTok Business messaging integration.
# Content Posting API must not use TIKTOK_BUSINESS_* credentials or callbacks.
TIKTOK_WEBHOOK_SECRET=

# Cloudinary Integration Config
CLOUDINARY_CLOUD_NAME=xx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# Bulk Create renderer
# hybrid: template scene v2 dùng Chromium và tự fallback Sharp; sharp/chromium: ép engine.
BULK_CREATE_RENDER_ENGINE=hybrid
BULK_CREATE_CHROMIUM_CONCURRENCY=2
BULK_CREATE_CHROMIUM_TIMEOUT_MS=30000
# Để trống để dùng Chromium do Remotion quản lý.
BULK_CREATE_CHROME_EXECUTABLE=
# Domain ảnh bổ sung, phân tách bằng dấu phẩy. Cloudinary đã được cho phép mặc định.
BULK_CREATE_ALLOWED_IMAGE_HOSTS=

# MongoDB Integration Config
MONGODB_URI=xxx
MONGODB_USER=xxx
MONGODB_PASSWORD=xxx
MONGODB_AUTH_SOURCE=xxx

# JWT Auth Config
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# ElevenLabs Integration Config
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Video Caption Pipeline — OpenRouter
# Whisper Large V3 returns word timestamps used by the editable caption timeline.
OPENROUTER_CAPTION_STT_MODEL=openai/whisper-large-v3
OPENROUTER_CAPTION_STT_DEFAULT_LANGUAGE=vi
# 20 MB normalized MP3 audio; increase only after confirming the provider limit.
OPENROUTER_CAPTION_STT_MAX_AUDIO_BYTES=20000000

# Contextual captions are routed through OpenRouter, never direct Gemini.
VIDEO_CAPTION_CONTEXT_MODEL=google/gemini-2.5-flash
VIDEO_CAPTION_MAX_DURATION_SECONDS=1800
VIDEO_CAPTION_SILENCE_THRESHOLD_DB=-30
VIDEO_CAPTION_MIN_SILENCE_SECONDS=0.1
VIDEO_CAPTION_DAILY_PROJECT_LIMIT=100
VIDEO_CAPTION_CAMPAIGN_DAILY_PROJECT_LIMIT=500
VIDEO_CAPTION_ANALYSIS_CONCURRENCY=2
# Comma-separated HTTPS media hosts allowed in addition to configured Cloudinary hosts
VIDEO_CAPTION_ALLOWED_MEDIA_HOSTS=
# Optional accounting rates; keep 0 when no internal cost rate is configured
VIDEO_CAPTION_STT_COST_PER_MINUTE=0
VIDEO_CAPTION_CONTEXT_COST_PER_MINUTE=0
VIDEO_CAPTION_RENDER_COST_PER_MINUTE=0

# HeyGen Integration Config
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_DEFAULT_AVATAR_ID=xxx
HEYGEN_DEFAULT_AVATAR_NAME=xxx
HEYGEN_DEFAULT_VOICE_ID=xxx
HEYGEN_DEFAULT_VOICE_NAME=xxx
HEYGEN_WEBHOOK_SECRET=xxx

# PIAPI
PIAPI_API_KEY=key_piapi

# Kling AI — Motion Control video generation
KLING_API_KEY=your_kling_api_key_here
# Mặc định dùng API toàn cầu; đổi thành https://api-singapore.klingai.com nếu cần region SG
KLING_API_BASE_URL=https://api.klingai.com

# Hermes Agent Integration Config
HERMES_API_KEY=your_hermes_api_key_here
HERMES_API_URL=https://agent.igentechsolutions.com
