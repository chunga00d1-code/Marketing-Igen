
# OpenRouter — nhà cung cấp chính cho text + image generation
OPENROUTER_API_KEY=sk-or-your-key-here

# Model sinh ảnh qua OpenRouter
# Gemini 3.1 Flash Image (Nano Banana 2) — dùng chat completions, hỗ trợ reference images
OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image"
# Hoặc dùng Gemini 3 Pro Image (Nano Banana Pro):
# OPENROUTER_IMAGE_MODEL="google/gemini-3-pro-image"

# Model text mặc định (không cần prefix — code tự thêm "google/")
GEMINI_MODEL="gemini-2.5-flash"

# Gemini API key — chỉ cần cho video analysis (Gemini Files API)
# Để trống nếu không dùng tính năng phân tích nội dung video
GEMINI_API_KEY=your-gemini-api-key-here

# Model sinh video (dùng PIAPI)
GEMINI_VIDEO_MODEL="veo31-video-fast-audio"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Super Admin Account Seed configuration credentials
VITE_SUPERADMIN_EMAIL=sxxx
VITE_SUPERADMIN_PASSWORD=sxxx
VITE_SUPERADMIN_NAME=xxx

# n8n Integration Config
N8N_FB_WEBHOOK_URL=xxx
N8N_FB_VALIDATE_URL=xxx
N8N_TT_VALIDATE_URL=xxx
N8N_WEBHOOK_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.com/api/v1/tiktok/oauth/callback
TIKTOK_BUSINESS_REDIRECT_URI=https://your-domain.com/api/v1/tiktok-business/oauth/callback
TIKTOK_WEBHOOK_SECRET=

# Cloudinary Integration Config
CLOUDINARY_CLOUD_NAME=xx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# MongoDB Integration Config
MONGODB_URI=xxx
MONGODB_USER=xxx
MONGODB_PASSWORD=xxx
MONGODB_AUTH_SOURCE=xxx

# JWT Auth Config
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

# ElevenLabs Integration Config
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# HeyGen Integration Config
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_DEFAULT_AVATAR_ID=xxx
HEYGEN_DEFAULT_AVATAR_NAME=xxx
HEYGEN_DEFAULT_VOICE_ID=xxx
HEYGEN_DEFAULT_VOICE_NAME=xxx
HEYGEN_WEBHOOK_SECRET=xxx

# PIAPI
PIAPI_API_KEY=key_piapi

# Kling AI — Motion Control video generation
KLING_API_KEY=your_kling_api_key_here
# Mặc định dùng API toàn cầu; đổi thành https://api-singapore.klingai.com nếu cần region SG
KLING_API_BASE_URL=https://api.klingai.com

# Hermes Agent Integration Config
HERMES_API_KEY=your_hermes_api_key_here
HERMES_API_URL=https://agent.igentechsolutions.com
