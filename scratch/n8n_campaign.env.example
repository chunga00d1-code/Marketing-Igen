# Environment variables for the self-hosted n8n instance.
# Keep the real file outside Git and restart n8n after changing values.

ERP_API_BASE_URL=https://erp-api.your-domain.com
CAMPAIGN_WORKER_SECRET=replace-with-the-same-worker-secret-as-erp
N8N_WEBHOOK_SECRET=replace-with-the-same-callback-secret-as-erp

# Worker batch limits. Keep these conservative until production metrics are available.
CAMPAIGN_PREPARE_LIMIT=3
CAMPAIGN_MEDIA_LIMIT=2
CAMPAIGN_VERIFY_LIMIT=5
CAMPAIGN_PUBLISH_LIMIT=3

# Required because the imported workflows read values through $env in expressions/Code nodes.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok

# Production hardening.
N8N_ENCRYPTION_KEY=replace-with-a-long-stable-random-encryption-key
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
N8N_LOG_LEVEL=info

# If n8n is running behind a reverse proxy (like Nginx, Traefik, Caddy, etc.),
# express-rate-limit will trigger a ValidationError unless you trust the proxy.
# Set N8N_PROXY_HOPS to the number of reverse proxies in front of n8n.
# (Use 2 if passing through both Cloudflare and Nginx).
N8N_PROXY_HOPS=2


