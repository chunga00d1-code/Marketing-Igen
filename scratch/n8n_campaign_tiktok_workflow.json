      "id": "tiktok-campaign-status",
      "name": "TikTok - Reconcile publish status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 330]
    },
    {
      "parameters": {
        "jsCode": "const names = ['TikTok - Prepare', 'TikTok - Media', 'TikTok - Verify', 'TikTok - Publish', 'TikTok - Reconcile publish status'];\nconst readStep = (name) => {\n  try {\n    return $items(name, 0, 0)[0]?.json || {};\n  } catch {\n    return { status: 'not_run' };\n  }\n};\nconst steps = names.map((name) => {\n  const response = readStep(name);\n  return {\n    name,\n    ok: response.status === 'success',\n    claimed: Number(response.data?.claimed || 0),\n    checked: Number(response.data?.checked || 0),\n    responseStatus: response.status || 'unknown',\n  };\n});\nconst failedSteps = steps.filter((step) => !step.ok).map((step) => step.name);\nreturn [{ json: {\n  status: failedSteps.length ? 'warning' : 'success',\n  platform: 'TikTok',\n  claimed: steps.reduce((sum, step) => sum + step.claimed, 0),\n  checkedPublishStatuses: steps.reduce((sum, step) => sum + step.checked, 0),\n  failedSteps,\n  steps,\n  executedAt: new Date().toISOString(),\n} }];"
      },
      "id": "tiktok-campaign-summary",
      "name": "TikTok - Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, 330]
    }
